GROQ_API_KEY=your_groq_api_key_here
OPENCODE_API_KEY=your_opencode_zen_api_key_here
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
OPENCODE_MODEL=deepseek-v4-flash-free
SESSION_NAME=arynox_session
# Dashboard password. Leave empty for no login (local use only).
# On any public/VPS deployment you MUST set this - the dashboard controls the bot.
DASHBOARD_PASSWORD=
# HTTP port for the dashboard
PORT=3000
# Backend: baileys (free, QR scan) or meta (official WhatsApp Cloud API)
WHATSAPP_BACKEND=baileys
# Meta Cloud API settings (only needed if WHATSAPP_BACKEND=meta)
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_API_VERSION=v23.0
META_PUBLIC_URL=
# Anti-ban safety limits (adjustable live from the dashboard)
SAFETY_DAILY_CAP=500
SAFETY_HOURLY_CAP=30
SAFETY_QUIET_ENABLED=true
SAFETY_QUIET_START=22
SAFETY_QUIET_END=8
# Turso cloud database (accounts, WhatsApp session backup, data sync)
# Create a free database at https://turso.tech then: turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Keep-alive: set to your public URL on Render/Koyeb so the service never sleeps
SELF_PING_URL=

